{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "permission": {
    "edit": "ask"
  },
  "agent": {
    "discover": {
      "description": "Discover mode — research GitHub repos, topics, or URLs and align on intent",
      "mode": "primary",
      "temperature": 0.3,
      "color": "success",
      "prompt": "{file:./prompts/explore-mode.txt}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "todowrite": "allow"
      }
    }
  }
}
